# ------------------------------------------------------------
# Variables de entorno - Sistema de Gestion de Eventos UCENFOTEC
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NO debe subirse al repositorio.
# ------------------------------------------------------------

# Cadena de conexion entregada por Atlas (Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://<usuario>:<password>@softwars.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos
DB_NAME=softwars_eventos

# Puerto local del servidor Express
PORT=3000

# Secreto de sesion (cadena aleatoria larga, distinta por entorno)
SESSION_SECRET=cambiar_por_una_cadena_aleatoria_larga

# Rondas de cifrado de bcrypt
BCRYPT_ROUNDS=10

# ------------------------------------------------------------
# Asistente de IA (SW-25)
# Clave de Google AI Studio: https://aistudio.google.com/apikey
# Si se deja vacia, el boton "Mejorar con IA" responde 503 con un aviso
# y el resto del sistema funciona con normalidad.
#
# ATENCION: este archivo SI se sube a GitHub. Es solo una plantilla.
# La clave real va en el archivo .env, que esta en .gitignore.
# Nunca escribir un valor real aqui.
# ------------------------------------------------------------
GEMINI_API_KEY=
# Usar el alias, no una version fija: los modelos con numero concreto
# (gemini-2.0-flash) pueden quedar con cuota 0 en el nivel gratuito.
GEMINI_MODEL=gemini-flash-latest