# ------------------------------------------------------------
# Variables de entorno - Sistema de Gestion de Eventos UCENFOTEC
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NO debe subirse al repositorio.
# ------------------------------------------------------------

# Cadena de conexion entregada por Atlas (Connect > Drivers > Node.js)
MONGODB_URI=mongodb+srv://<usuario>:<password>@softwars.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos
DB_NAME=softwars_eventos

# Puerto local del servidor Express
PORT=3000

# Secreto de sesion (cadena aleatoria larga, distinta por entorno)
SESSION_SECRET=cambiar_por_una_cadena_aleatoria_larga

# Rondas de cifrado de bcrypt
BCRYPT_ROUNDS=10

# Credenciales MongoDB Josue
MONGODB_URI=mongodb+srv://<jarroyor_db_user>:<uIGLGKymDy66tCvj>@proyecto-integrador.xbw129y.mongodb.net/?appName=proyecto-integrador
PORT=3000